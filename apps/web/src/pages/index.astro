---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchIsland from "../islands/SearchIsland.tsx";
---

<BaseLayout
  pageTitle="Is It Taken? Package name availability, checked."
  description="Search a seed word for synonyms, get creative AI alternatives, and check whether the names are available on npm."
>
  <section class="hero">
    <h1>Is that package name taken?</h1>
    <p>
      Type a word. We collect synonyms and related words, invent a few creative alternatives if you
      ask, and check each candidate against npm. An honest <strong>unknown</strong> is given when npm
      can't answer.
    </p>
  </section>

  <SearchIsland client:load />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <ol>
      <li>Your seed word becomes the first candidate.</li>
      <li>
        Wordnik contributes synonyms and related words; a failed lookup is reported, never hidden.
      </li>
      <li>
        Candidates are normalized and deduplicated, then checked against npm's registry with bounded
        concurrency.
      </li>
      <li>
        Optional: sign in with GitHub for AI-generated name ideas with per-user quotas. Anonymous
        search works fine without it.
      </li>
    </ol>
    <p>
      See <a href="/docs/methodology">methodology</a> for how results are classified, and why scoped npm
      names are out of scope.
    </p>
  </section>
</BaseLayout>
