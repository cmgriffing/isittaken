---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchIsland from "../islands/SearchIsland.tsx";
---

<script>
  // WebMCP tools: feature-detected, home page only, no-op elsewhere.
  import { registerWebMcpTools } from "../lib/client/webmcp/adapter";
  registerWebMcpTools();
</script>

<BaseLayout
  pageTitle="Is It Taken? Package name availability, checked."
  description="Search a seed word for synonyms, get creative AI alternatives, and check whether the names are available across npm, PyPI, RubyGems, Hex, Maven Central, crates.io, NuGet, and Packagist."
>
  <section class="hero">
    <h1>Is that package name taken?</h1>
    <p>
      Type a word. We'll gather synonyms, invent a few alternatives, and check what's free across 8
      registries.
    </p>
  </section>

  <SearchIsland client:load />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <ol>
      <li>Your seed word becomes the first candidate.</li>
      <li>Wordnik adds synonyms and related words.</li>
      <li>
        Normalized candidates are checked against your selected registries; results fill in
        progressively.
      </li>
      <li>Optional: sign in with GitHub for AI-generated ideas.</li>
    </ol>
    <p>
      See <a href="/docs/methodology">methodology</a> for how results are classified, and why scoped npm
      names are out of scope.
    </p>
  </section>
</BaseLayout>
