# Copy to `.env` for local development. Never commit real secrets.
# The Netlify Vite plugin loads this file for `astro dev`.

# --- Database ---------------------------------------------------------------
# Local development uses a local SQLite file. In Netlify (deployed
# environments) set these to your Turso database URL and auth token.
DATABASE_URL=file:./local.db
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# --- Wordnik ----------------------------------------------------------------
WORDNIK_API_KEY=
WORDNIK_BASE_URL=https://api.wordnik.com/v4

# --- npm --------------------------------------------------------------------
# Fixed registry origin; requests cannot override this.
NPM_REGISTRY_ORIGIN=https://registry.npmjs.org

# --- GitHub OAuth ------------------------------------------------------------
# Register a separate OAuth App per environment (local + production) and set
# the authorization callback URL to <site>/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OpenRouter (creative generation) ---------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model must support structured output (JSON Schema response format).
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_PROMPT_VERSION=1
OPENROUTER_SCHEMA_VERSION=1

# --- Sessions ----------------------------------------------------------------
# Session cookie secure flag: `false` is only appropriate for http://localhost.
SESSION_COOKIE_SECURE=false
PUBLIC_SITE_URL=http://localhost:4321

# --- Cache policy (milliseconds) ---------------------------------------------
CACHE_TTL_WORDNIK_MS=604800000
CACHE_TTL_OPENROUTER_MS=259200000
CACHE_TTL_NPM_AVAILABLE_MS=300000
CACHE_TTL_NPM_TAKEN_MS=86400000

# --- Quotas (creative generation) --------------------------------------------
QUOTA_USER_BURST_PER_MINUTE=5
QUOTA_USER_PERIODIC_PER_DAY=25
QUOTA_APP_DAILY_GENERATIONS=1000

# --- Rate limits --------------------------------------------------------------
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=30
RATE_LIMIT_CREATIVE_PER_MINUTE=10

# --- Limits -------------------------------------------------------------------
LIMIT_MAX_SEED_LENGTH=64
LIMIT_MAX_INJECTED_SYNONYMS=25
LIMIT_MAX_INJECTED_CREATIVES=25
LIMIT_MAX_CANDIDATE_LENGTH=214
LIMIT_MAX_TOTAL_CANDIDATES=120
